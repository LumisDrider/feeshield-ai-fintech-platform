# PostgreSQL used by the Next.js application and FastAPI service
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional provider-independent OpenAI-compatible structured extraction
# Leave AI_API_KEY empty to use the transparent rule-based fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25

# Optional vision model used for scanned PDFs/images before local OCR fallback
AI_VISION_MODEL=gpt-4o-mini

# Optional OCR binary for scanned PDFs in the standalone FastAPI service
# (the Next.js runtime uses vendored tessdata/ and needs no system binary)
TESSERACT_CMD=tesseract
MAX_FILE_SIZE_MB=8
MAX_DOCUMENT_CHARACTERS=180000

# FastAPI development server
HOST=0.0.0.0
PORT=8000
